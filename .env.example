# Copiar este archivo a .env y completar los valores antes de levantar el proyecto.
# .env nunca debe commitearse (ya está en .gitignore).

# --- CIViC (app/bronze/civic_explorer.py) ---
# API key de https://civicdb.org (Account Settings -> API Key). Se envía como Bearer token.
CIVIC_API_KEY=
# --- ClinVar / NCBI E-utilities (app/bronze/clinvar_explorer.py) ---
# Opcional: sin esta key, E-utilities limita a 3 req/s; con key, 10 req/s.
# Generar gratis en https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management).
NCBI_API_KEY=
# --- Neo4j (docker-compose.yml expone bolt://localhost:7687) ---
# Los valores por defecto abajo coinciden con NEO4J_AUTH en docker-compose.yml.
# Cambiar la contraseña por defecto antes de desplegar fuera de un entorno local.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pharoxpass

# --- Ollama (LLM local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Anonimización de pacientes (app/pipeline_etl.py) ---
# Salt secreto usado junto con SHA-256 para generar el patient_hash_sha256.
# Requerido: el pipeline aborta si no está definido. Debe ser único por
# entorno y nunca reutilizarse entre entornos (dev/staging/prod), porque
# reusar el mismo salt entre entornos con distintos niveles de exposición
# facilita re-identificar pacientes si un entorno menos protegido se filtra.
ANONYMIZATION_SALT=

# --- Autenticación de la API (app/main.py) ---
# Clave requerida en el header X-API-Key para todos los endpoints salvo "/".
# Requerido: el backend no arranca sin esto. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PHAROX_API_KEY=

# --- CORS (app/main.py) ---
# Orígenes permitidos para llamadas desde el navegador, separados por coma.
# Nunca usar "*" en producción. Por defecto solo habilita el frontend local.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
