# Copiar este archivo a .env y completar los valores antes de levantar el proyecto.
# .env nunca debe commitearse (ya está en .gitignore).

# --- CIViC (app/bronze/civic_explorer.py) ---
# API key de https://civicdb.org (Account Settings -> API Key). Se envía como Bearer token.
CIVIC_API_KEY=

# --- ClinVar / NCBI E-utilities (app/bronze/clinvar_explorer.py) ---
# Opcional: sin esta key, E-utilities limita a 3 req/s; con key, 10 req/s.
NCBI_API_KEY=

# --- Neo4j: instancia AuraDB compartida por el equipo (app/config.py) ---
# La contraseña se pide al equipo por un canal privado; nunca se commitea.
# NEO4J_DATABASE: en AuraDB es el id de la instancia. Si se omite, se usa la base
# por defecto del usuario.
# Para usar el Neo4j local (docker compose --profile local-db up):
#   NEO4J_URI=bolt://localhost:7687 (o bolt://neo4j:7687 desde el contenedor del backend)
#   NEO4J_USER=neo4j  NEO4J_PASSWORD=pharoxpass  NEO4J_DATABASE=neo4j
NEO4J_URI=neo4j+s://2661a5a9.databases.neo4j.io
NEO4J_USER=2661a5a9
NEO4J_PASSWORD=
NEO4J_DATABASE=2661a5a9

# --- Ollama (LLM local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Anonimización de pacientes (app/pipeline_etl.py) ---
# Salt secreto usado junto con SHA-256 para generar el patient_hash_sha256.
# Requerido y único por entorno: reusarlo entre entornos facilita re-identificar
# pacientes si un entorno menos protegido se filtra.
ANONYMIZATION_SALT=

# --- Autenticación de la API (app/config.py, app/api/seguridad.py) ---
# Clave requerida en el header X-API-Key para todos los endpoints salvo "/".
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHAROX_API_KEY=

# --- Verificación de la redacción del LLM (app/lenguaje/verificacion.py) ---
# advertir (default): la redacción se devuelve siempre, con un aviso visible si
# nombra fármacos, ensayos, PMIDs o cifras que no están en la evidencia.
# estricta: en ese caso se descarta y se devuelve solo el material determinístico.
PHAROX_VERIFICACION=advertir

# --- CORS (app/config.py) ---
# Orígenes permitidos para llamadas desde el navegador, separados por coma. Nunca "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
